# Project-critical scheduling and console choices.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Mission logging uses descriptive file and directory names.
CONFIG_FATFS_LFN_HEAP=y

# ESP32-S3-WROOM-1U-N16R8 board memory. Keep ordinary malloc() internal until
# large, non-real-time workspaces are migrated deliberately with heap_caps.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# Keep latency-sensitive stacks and FatFs buffers in internal RAM. PSRAM is
# reserved for explicit large allocations until each workload is qualified.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n

# ESP32-S3-WROOM-1U-N16R8 flash. DIO at 80 MHz is already qualified on the
# production board; the custom table reserves factory/recovery and two OTA
# images without enabling OTA or rollback policy prematurely.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
