# ESP-IDF/CMake generated build trees. The suffix form covers temporary
# diagnostic directories such as build-codex and build-uart-b.
/build*/

# ESP-IDF configuration backups and generated root-level tooling files.
/sdkconfig.old
/compile_commands.json

# Local logs and editor/OS debris.
*.log
*.tmp
*.bak
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
Thumbs.db

# Local service credentials. Commit the matching *.example.json template only.
/tools/mission_viewer/credentials/*.local.json
